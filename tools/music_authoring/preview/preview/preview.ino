/*
 * AVR preview fixture for ATMlib2FX-3ii.2 (bounded faithful WAV preview).
 *
 * Plays the PROGMEM score generated by tools/atm-music through the *unmodified*
 * library, with the Arduboy speaker pins enabled, so that examples run under
 * absim produce real audio (see tools/music_authoring/preview/).
 *
 * The only difference from examples/music_authoring/basic/avr/avr.ino is the
 * speaker output-enable: DDRC6/DDRC7, which is exactly what
 * Arduboy2Audio::on() does for the built-in speaker (SPEAKER_1 = PC6,
 * SPEAKER_2 = PC7).  Without it the emulator's sound path is disabled and the
 * capture is silent; that fixture is a compile/resource fixture only.
 *
 * This sketch ships as a host renderer input; it adds nothing to src/ or to
 * game builds. Never executed on real hardware by the preview tooling.
 */
#include <Arduino.h>
#include <ATMlib.h>
#include <avr/io.h>

#include "score.h"

void setup() {
  /* Enable the built-in speaker pins (Arduboy2Audio::on() equivalent). */
  DDRC |= _BV(DDC6) | _BV(DDC7);

  atm_synth_setup();
  atm_synth_play_score((const uint8_t *)score);
}

void loop() {
}
